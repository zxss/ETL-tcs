# stage2-demo-15d — функциональный тест на демо-счёте (STAGE2-DEMO-TZ.md §14)
#
# Установка:   crontab scripts/stage2_crontab
# Проверка:    crontab -l
# Снять:       crontab -r
#
# Четыре ОТДЕЛЬНЫХ задания, а не один общий запуск: если одна фаза упала,
# остальные должны отработать самостоятельно и попасть в дневной аудит.
#
# Cron не знает о биржевых праздниках — проверку торгового дня делает сам
# оркестратор через services/calendar. В праздник фаза выходит с кодом 0 и
# отметкой skipped, каталог запуска всё равно создаётся.
#
# Времена ДУБЛИРУЮТ config.STAGE2_*_TIME. При изменении конфигурацииэтот файл
# нужно перевыпустить: cron не читает .env.
#
# ВАЖНО: 1-5 — это Пн-Пт. Биржа торгует и по выходным, но модель при
# INCLUDE_WEEKEND_TRADING=0 работает по календарю Пн-Пт, и тест следует ему же.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
PROJECT=/opt/etl-tcs
PY=/opt/etl-tcs/.venv/bin/python

# PREP 09:45 — считает сигналы и замораживает план, заявок не ставит
45  9 * * 1-5  cd $PROJECT && $PY -m services.stage2_demo prep      >> audit/stage2-demo/cron.log 2>&1

# ORDER 10:05 — исполняет замороженный план (только intraday_*)
 5 10 * * 1-5  cd $PROJECT && $PY -m services.stage2_demo order     >> audit/stage2-demo/cron.log 2>&1

# CLEANUP 18:20 — закрывает интрадей до аукциона 18:40-18:50
20 18 * * 1-5  cd $PROJECT && $PY -m services.stage2_demo cleanup   >> audit/stage2-demo/cron.log 2>&1

# OVERNIGHT 18:35 — ночные заявки, дневной аудит, счётчик
35 18 * * 1-5  cd $PROJECT && $PY -m services.stage2_demo overnight >> audit/stage2-demo/cron.log 2>&1
