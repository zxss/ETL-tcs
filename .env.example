# =====================================================================
# etl-tcs — каноническая конфигурация Этапа 2 (Paper Trading / Sandbox)
#
# Скопируйте в .env и заполните секреты. Файл .env в git не попадает.
# Все значения ниже — ДЕФОЛТЫ кода: пустой .env даёт ровно эту конфигурацию.
# Обоснование каждого значения — в комментариях config.py и в
# AUDIT-PROFITABILITY-REPORT.md.
# =====================================================================

# =====================================================================
# БЕЗОПАСНОСТЬ И ДОСТУП
# =====================================================================
INVEST_TOKEN=t.your_secure_invest_token_here
INVEST_TLS_VERIFY=1
# Корневой сертификат «Russian Trusted Root CA» (Минцифры) — без него
# проверка TLS падает с CERTIFICATE_VERIFY_FAILED.
# INVEST_CA_BUNDLE=/path/to/russian-trusted-bundle.pem

# Контур по умолчанию. Боевой режим требует ОДНОВРЕМЕННО TRADING_MODE=prod
# и флага --prod: переменная может только ограничить права, но не расширить.
TRADING_MODE=sandbox
# PROD_ACCOUNT_ID=                 # Заполняется ТОЛЬКО при переходе на реальный депозит
# ID счёта в песочнице (создаётся автоматически, если пусто). Комментарий —
# отдельной строкой: python-dotenv при пустом значении берёт «# …» как значение.
SANDBOX_ACCOUNT_ID=
ALLOW_UNATTENDED_PROD=0            # Запрет связки --prod --no-confirm

# =====================================================================
# POSTGRESQL
# =====================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_data
DB_USER=postgres
DB_PASSWORD=

# =====================================================================
# СТРАТЕГИИ И МЕНЮ СИГНАЛОВ
# =====================================================================
# Исключён intraday_long: средняя доходность -0.2393% при t = -17.26.
# Удаление поднимает CAGR портфеля с -2.8% до +0.5% и улучшает Sharpe
# в ОБЕИХ половинах выборки.
TRADING_STRATEGIES=intraday_short long_overnight

# Валидатор продолжает считать всю тройку — иначе мы перестанем видеть,
# что происходит с исключённой стратегией при смене режима.
VALIDATION_STRATS=long_overnight intraday_short intraday_long

# Шорт недоступен у брокера (проверено через InstrumentsService/ShareBy:
# shortEnabledFlag = false). Список дополняет встроенный, а не заменяет.
NON_SHORTABLE_TICKERS=AKRN CBOM MVID

# =====================================================================
# СКОРИНГ И РАНЖИРОВАНИЕ СИГНАЛОВ
# =====================================================================
# heuristic — победитель теста на устойчивость: первый в ОБЕИХ половинах
# выборки. У raw_alpha выше Rank IC (0.054 против 0.051), но хуже портфель:
# сырой exp_pnl смещён в волатильные бумаги (корреляция |exp_pnl| с шириной
# коридора +0.285).
SCORE_MODE=heuristic

# 0 — отключить мультипликативные риск-штрафы: они ухудшают результат во всех
# режимах ранжирования (у эвристики альфа -1.2% -> +2.1%).
APPLY_RISK_PENALTIES=0

# Шортить интрадей только в дни импульса продавцов (вчера падение И
# волатильность рынка выше медианы).
# ВНИМАНИЕ: это НЕ альфа. В дни срабатывания фильтра равновзвешенный рынок
# даёт -0.2100% против -0.0017% в остальные, то есть шорт зарабатывает
# +52.9% годовых чистой бетой. Это тайминг падения рынка, а не отбор бумаг:
# знак результата зависит от того, продолжится ли медвежий режим.
SELLER_MOMENTUM_SHORT_ENABLED=1

# Предохранитель от шорт-сквиза: не шортить, когда IMOEX выше своей EMA50.
# Пустое значение отключает. На этой выборке СТОИТ ~3 п.п. CAGR (12.4% -> 9.3%)
# и не улучшает просадку — защищает от режима, которого в данных нет.
SHORT_IMOEX_MAX_TREND=EMA50

# Предохранители для long_overnight.
# Потолок волатильности почти ни на что не влияет (12.363% -> 12.347%).
# Порог преимущества доказательной базы НЕ имеет: t средней доходности нигде
# не выше 1.0, Sharpe второй половины отрицателен при любом пороге.
OVERNIGHT_MAX_MARKET_ATR_PCTL=70
OVERNIGHT_MIN_EDGE_X_COST=0.5

# Гейт по вердикту валидатора. ВНИМАНИЕ: сейчас REJECTED имеют 138 комбинаций
# из 138, поэтому STRICT_VALIDATION_GATE=1 остановит торговлю полностью.
# При 0 печатается громкое предупреждение и запрашивается подтверждение.
STRICT_VALIDATION_GATE=0

# =====================================================================
# МИКРОСТРУКТУРА И ИСПОЛНЕНИЕ
# =====================================================================
# 0.2 от края коридора: fill rate 57.1% против 14.1% при 0.8, где 74.7%
# заливок заканчивались стопом.
LIMIT_ENTRY_FRACTION=0.2

# 0.5 вместо 1.0: доля достижения цели растёт с 1.9% до 11.2%.
# По среднему PnL близкая цель слегка хуже (срезает прибыльные хвосты) —
# значение выбрано ради работоспособности механизма TP, а не ради доходности.
LIMIT_TP_FRACTION=0.5

# Медиана заливки — 30 минут после открытия, так что единый прогон всё равно
# почти всегда уходит не дождавшись; 60 с ловит те заявки, что заливаются сразу.
ORDER_FILL_WAIT_SEC=60
ORDER_FILL_POLL_SEC=5

# Принудительное закрытие внутридневных позиций: без него 79.1% заливок не
# достигают ни стопа, ни цели и переносятся через ночь. Цена дефекта на
# реплее — 14.6 п.п. итоговой доходности.
# Запускать отдельной фазой: python3 -m services.place_orders --square-off
# Cron: 35 18 * * 1-5
INTRADAY_SQUARE_OFF_ENABLED=1
INTRADAY_SQUARE_OFF_TIME=18:20          # было 18:35 — окно для фазы OVERNIGHT

# =====================================================================
# КВАНТОВАНИЕ ЛОТОВ И РИСК
# =====================================================================
# skip — единственный поддерживаемый режим. Прежнее округление вверх до
# одного лота покупало больше, чем посчитала модель (GMKN: лот 1296 ₽ при
# лимите 500 ₽ — в 2.6 раза), обходя риск-сайзинг.
FIXED_POSITION_OVERFLOW_MODE=skip

# Концентрация в топ-5: CAGR 10.4% против 9.3% при top-10 и просадка
# -19.7% против -22.1%.
BEST_TRADES_TOP_N=5
BEST_TRADES_POSITION_RUB=100000      # с прогона r4 (депозит 5 млн ₽): 5 × 100k = 10 % в риске
OVERNIGHT_VAR_PCT=2.3                # ночной VaR 99 % в % от корзины (замер 24.09.2026)
OVERNIGHT_VAR_BUDGET_RUB=0           # 0 = лимит ночного риска ВЫКЛЮЧЕН; >0 — урезает корзину
OVERNIGHT_VAR_VOL_SCALING=1          # расширять VaR по режиму волы (никогда не ниже 2.3%)

# Аудит 26.09.2026 (AUDIT-FULL-2026-09-26.md)
MODEL_BARS=session                   # бары основной сессии из 5M: overnight = торгуемое окно 18:40→09:10
TFT_REFIT_EPOCHS=5                   # дообучение на всей выборке после валидации (0 — без)
COST_MODEL=matrix                    # поштучный круг из audit/out/cost_matrix.csv (flat — плоский)
STAGE2_NEW_ENTRIES=1                 # 0 — счёт только сопровождает позиции, новых входов нет

# Дивидендные отсечки. Вход в ночь перед гэпом = минус НДФЛ с дивиденда
# (медианный гэп 5.2%, то есть -0.68% на позицию) плюс вынос стопа в аукционе.
LOAD_DIVIDENDS=1                     # ежедневное обновление календаря отсечек
DIVIDENDS_HISTORY_YEARS=12           # глубина запроса GetDividends, лет
OVERNIGHT_SKIP_EX_DIV=1              # не входить в ночь вечером last_buy_date
DIVIDEND_ADJUST_FEATURES=1           # дивидендная поправка обучающей выборки

# Безрисковая планка: ключевая ставка ЦБ. Деньги в фонде денежного рынка идут
# за ставкой, поэтому итог торговли сравнивается с ней, а не с нулём.
LOAD_MACRO=1
MACRO_HISTORY_DAYS=400               # глубина запроса ставки, календарных дней

# =====================================================================
# ИЗДЕРЖКИ
# =====================================================================
# Плоские 0.08% занижают реальные издержки в 1.6 раза — для ВСЕХ 46 бумаг
# без исключений. Медиана честной оценки 0.128%. Матрица по тикерам:
# audit/out/cost_matrix.csv, колонка cost_rt_base.
VALIDATION_COST_RT=0.128
TFT_COST_RT=0.128
# VALIDATION_COST_RT_MAP="ETLN:0.18 SMLT:0.16 MVID:0.19 SELG:0.13"

# Честная мультитестовая вселенная: при семействе из 6 «любимчиков» BH-FDR
# проходят 100% комбинаций, при честных 46 — лишь 30%.
VALIDATION_FULL_UNIVERSE=1

# --- Этап 2: функциональный тест на демо-счёте --------------------------------
# Издержки round-trip: 0.128% вместо 0.08% — переаудит показал занижение в 1,6 раза
VALIDATION_COST_RT=0.128
TFT_COST_RT=0.128
# Честная мультитестовая вселенная: HAC-t по всем тикерам + BH-FDR по полной сетке
VALIDATION_FULL_UNIVERSE=1

STAGE2_ENABLED=1
STAGE2_TEST_ID=stage2-demo-15d
STAGE2_TARGET_DAYS=15
# 0 — выключено. Число залитых сделок (execution_audit, filled=true) от дня
# старта теста, отдельно по SANDBOX/PROD — для зачётных условий (турнир и
# т.п.). Строка «сделок в зачёте: N / target» появляется в карточке Telegram.
STAGE2_TRADE_TARGET=0
# "" — выключено. Метка в шапке карточки Telegram (например «ТУРНИР»), когда
# несколько контуров шлют уведомления в один и тот же чат/бот.
STAGE2_NOTIFY_LABEL=
STAGE2_PREP_TIME=08:45               # до аукциона открытия 09:00 (расписание с 14.09.2026)
STAGE2_ORDER_TIME=09:15              # через 5 минут после CLOSE
STAGE2_CLEANUP_TIME=18:20
STAGE2_OVERNIGHT_TIME=18:35
STAGE2_ALLOW_DATASET_DRIFT=0
STAGE2_HALT_ON_FAIL=1
STAGE2_START_BALANCE_RUB=100000

# ── Уведомления в Telegram ────────────────────────────────────────────────────
# Статус каждой фазы Этапа 2 и дневная сводка приходят в чат сразу после крона.
# TELEGRAM_BOT_TOKEN — СЕКРЕТ, в git не попадает (.env в .gitignore).
# chat_id: написать боту любое сообщение, затем
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/getUpdates"
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT_PHASES=1        # рутинный PASS без звука; FAIL и итог дня звучат

# ── Хотфиксы 11.09: выход из овернайта, стопы, лимиты брокера ─────────────────
MIN_STOP_PCT=1.0                     # стоп не ближе 1% от входа, всегда на убыточной стороне
STAGE2_CLOSE_TIME=09:10              # выход long_overnight: первая минута торгов после аукциона
STAGE2_PARK_TIME=10:05               # казначейство: TMON@ на СПБ торгуется через API с 10:00
# ISO-дата старта теста; до неё фазы молчат
STAGE2_START_DATE=
BROKER_ORDER_MIN_INTERVAL_SEC=0.25   # пауза между заявками брокеру
BROKER_429_RETRIES=3                 # повторы при HTTP 429: 1 → 2 → 4 с
SQUARE_OFF_FILL_TIMEOUT_SEC=30        # CLEANUP: ждать обнуления позиции у брокера
REGISTRY_LOCK_TIMEOUT_SEC=600        # фаза ждёт освобождения реестра стопов (flock)

# ── Казначейство: парковка кэша в фонд денежного рынка (services/treasury.py) ──
TREASURY_ENABLED=1
TREASURY_TICKER=TMON
# пусто — первый листинг фонда, доступный через API (TMON@ на СПБ)
TREASURY_CLASS_CODE=
TREASURY_CASH_BUFFER_RUB=30000.0     # остаток кэша: комиссии, округление и резерв песочницы 0,5 % сверх заявки
TREASURY_MIN_SWEEP_RUB=10000.0       # не парковать суммы меньше этой
TREASURY_LIMIT_MAX_PREMIUM_PCT=0.05  # PARK: лимит покупки паёв — последняя сделка + 0,05 %

