# =====================================================================
# etl-tcs — профиль «турнир на боевом счёте Робот» (ТЗ пользователя 23.09.2026)
#
# ЭТОТ ФАЙЛ НЕ ЗАПУСКАЕТ ЖИВУЮ ТОРГОВЛЮ САМ ПО СЕБЕ.
# Это ШАБЛОН параметров поверх .env.example — код и стратегии не менялись
# («торговый режим используем существующий»). Полный список того, что нужно
# сделать ЛИЧНО пользователю, чтобы контур реально стал боевым, — в
# TOURNAMENT-LIVE-PREP.md, раздел «5 замков». Ни один секрет сюда не вписан.
#
# Параллельность: отдельный STAGE2_DIR/STAGE2_TEST_ID — состояние турнира
# не пересекается со счётчиком дней песочницы stage2-demo-30d-r4.
# =====================================================================

# --- Позиционирование под баланс 1 040 000 ₽ -------------------------------
# Пропорция сохранена ТОЧНО как в r4 (100 000 ₽ на позицию при 5 000 000 ₽ —
# те же 2 % капитала на сделку, 5 позиций = 10 % капитала в риске за ночь).
# 1 040 000 × 2 % = 20 800 → округлено вниз для удобства квантования лотов.
BEST_TRADES_TOP_N=5
BEST_TRADES_POSITION_RUB=20000
STAGE2_START_BALANCE_RUB=1040000

# --- Казначейство -----------------------------------------------------------
# 30 000 ₽ буфера в r4 закрывали в основном ПЕСОЧНОЧНУЮ квоту брокера — резерв
# 0,5 % сверх суммы заявки при постановке (её на боевом контуре может не быть
# или она другая). Буфер ниже — оценка сверху для комиссий/округления; ОБЯЗАН
# быть перепроверен первой же живой сделкой малого объёма до полного включения.
TREASURY_CASH_BUFFER_RUB=5000.0
TREASURY_MIN_SWEEP_RUB=2000.0

# --- Счётчик турнира ---------------------------------------------------------
# ВАЖНО: как и в «30-дневном» r4, target_trading_days считает ТОРГОВЫЕ дни,
# не календарные. «24 дня» из ТЗ — под вопросом (см. TOURNAMENT-LIVE-PREP.md,
# раздел 3): если организаторы турнира имеют в виду 24 КАЛЕНДАРНЫХ дня, это
# ≈ 17 торговых — цифру ниже нужно подтвердить, прежде чем полагаться на неё.
STAGE2_TEST_ID=tournament-robot-24d
STAGE2_TARGET_DAYS=24
STAGE2_DIR=audit/stage2-tournament
STAGE2_START_DATE=

# --- Активация боевого контура (СЕЙЧАС НАМЕРЕННО ПУСТО) ---------------------
# Ниже — 3 из 5 замков (см. TOURNAMENT-LIVE-PREP.md). Оставлены пустыми/
# закомментированными. Их заполняет и включает ТОЛЬКО пользователь на своём
# боевом .env — не в этом шаблоне, не в git, не мной.
# TRADING_MODE=prod
# PROD_ACCOUNT_ID=
# ALLOW_UNATTENDED_PROD=1
